# Optional explicit overrides for the Linux x86_64 local VM workflow.
# Copy outside Git-tracked paths or export only the values you need.
VM_ENV_ID=isureal-local
VM_TOPOLOGY=provisioning/config/topology.yml
VM_RELEASE=provisioning/config/release.json
VM_PROFILE=compact
VM_PROVIDER=virtualbox
VM_OUTPUT=human

# Destructive commands require one of these to equal VM_ENV_ID.
# CONFIRM_RESET=isureal-local
# CONFIRM_DESTROY=isureal-local
