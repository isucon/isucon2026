{% set mac = isucon_network_interface.macAddress | lower %}
[Match]
MACAddress={{ mac[0:2] }}:{{ mac[2:4] }}:{{ mac[4:6] }}:{{ mac[6:8] }}:{{ mac[8:10] }}:{{ mac[10:12] }}

[Link]
RequiredForOnline=no

[Network]
Address={{ isucon_network_interface.address }}/{{ isucon_network_interface.cidr.split('/')[1] }}
IPv4Forwarding={{ 'yes' if isucon_node.role == 'router' else 'no' }}
LinkLocalAddressing=no
IPv6AcceptRA=no
{% if isucon_node.role == 'problem-server' %}
{% for route in isucon_network_routes %}

[Route]
Destination={{ route }}
Gateway={{ isucon_router_address }}
{% endfor %}
{% endif %}
