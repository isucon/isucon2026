#!/usr/bin/env bash
set -euo pipefail

interface_for_mac() {
  local wanted="${1,,}"
  local address_file
  for address_file in /sys/class/net/*/address; do
    if [[ "$(<"${address_file}")" == "${wanted}" ]]; then
      basename "$(dirname "${address_file}")"
      return 0
    fi
  done
  return 1
}

sysctl --system >/dev/null
{% for interface in isucon_network_interfaces %}
{% set mac = interface.macAddress | lower %}
iface_{{ interface.role }}="$(interface_for_mac '{{ mac[0:2] }}:{{ mac[2:4] }}:{{ mac[4:6] }}:{{ mac[6:8] }}:{{ mac[8:10] }}:{{ mac[10:12] }}')"
ip link set "${iface_{{ interface.role }}}" up
ip address replace "{{ interface.address }}/{{ interface.cidr.split('/')[1] }}" dev "${iface_{{ interface.role }}}"
{% endfor %}
{% if isucon_node.role == 'problem-server' %}
{% for route in isucon_network_routes %}
ip route replace "{{ route }}" via "{{ isucon_router_address }}" dev "${iface_data0}"
{% endfor %}
{% endif %}
