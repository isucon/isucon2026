[Unit]
Description=ISUReal deterministic network and isolation policy
After=network-online.target
Wants=network-online.target
Before=isureal-api.service isureal-router.service isureal-envoy.service nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/isureal-network-apply
ExecStart=/usr/local/sbin/isureal-firewall-apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
