[Unit]
Description=ISUReal Router configuration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isureal-router
Group=isureal-router
EnvironmentFile=/etc/isucon/router-control.env
ExecStart=/opt/isucon/bin/isureal-router-control
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
