[Unit]
Description=ISUReal digest proxy for the benchmark's image downloads
After=network-online.target
Wants=network-online.target
# isureal-haproxy.service starts it; HAProxy sends the requests to the apps
# itself while it is down.
PartOf=isureal-haproxy.service

[Service]
User=isureal-router
Group=isureal-router
EnvironmentFile=/etc/isucon/router.env
LimitNOFILE=1048576
ExecStart=/opt/isucon/bin/isureal-digest
Restart=always
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
