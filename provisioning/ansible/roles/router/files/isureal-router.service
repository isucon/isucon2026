[Unit]
Description=ISUReal Router controller
# The first snapshot is applied through the HAProxy runtime API, so HAProxy
# must listen before the controller starts.
After=network-online.target isureal-haproxy.service
Wants=network-online.target

[Service]
Type=simple
User=isureal-router
Group=isureal-router
EnvironmentFile=/etc/isucon/router.env
ExecStart=/opt/isucon/bin/isureal-router
Restart=on-failure
RestartSec=1s
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
