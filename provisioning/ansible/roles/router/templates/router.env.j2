ROUTER_PORTAL_ENDPOINT=http://127.0.0.1:18082
ROUTER_TEAM_NUMBER=1
ROUTER_XDS_LISTEN_ADDRESS=127.0.0.1:18000
ROUTER_STATUS_LISTEN_ADDRESS={{ router_control_address }}:18081
ROUTER_ENVOY_NODE_ID=isureal-router-envoy
ROUTER_ROUTE_CONFIG_NAME=isureal_routes
ROUTER_APP_HOST=app.{{ team_domain }}
{% for server in servers %}
{% set prefix = 'ROUTER_' ~ server.name | upper %}
{% if server.name != 'db1' %}
{{ prefix }}_HOST={{ server.name }}.{{ team_domain }}
{% endif %}
{{ prefix }}_SUBNET={{ server.cidr }}
{{ prefix }}_REGION_LOCAL_IP={{ router_data_address }}
{{ prefix }}_IP={{ server.address }}
{% endfor %}
