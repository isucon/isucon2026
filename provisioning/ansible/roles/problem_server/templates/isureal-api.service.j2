[Unit]
Description=ISUReal backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isureal
Group=isureal
WorkingDirectory=/opt/isucon
EnvironmentFile=/etc/isucon/backend.env
ExecStart=/opt/isucon/bin/api
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/isureal

[Install]
WantedBy=multi-user.target
