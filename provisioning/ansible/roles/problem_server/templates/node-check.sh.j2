#!/usr/bin/env bash
set -euo pipefail
{% if isucon_node_id == 'db1' %}
systemctl is-active --quiet postgresql@16-main.service
pg_isready -q -h {{ isucon_data_address }}
{% else %}
systemctl is-active --quiet isureal-api.service
systemctl is-active --quiet isureal-worker.service
systemctl is-active --quiet nginx.service
curl --fail --silent --show-error http://127.0.0.1:8081/health/ready >/dev/null
curl --fail --silent --show-error -H 'Host: app.team{{ isucon_topology.portal.teamNumber }}-{{ isucon_topology.portal.teamHash }}.{{ isucon_topology.domain }}' \
  http://{{ isucon_data_address }}:8080/ >/dev/null
{% endif %}
printf '%s\n' '{{ isucon_node_id }}: ready'
