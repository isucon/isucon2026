# frozen_string_literal: true

require "json"
require "ipaddr"
require "yaml"

repo_root = File.expand_path("../..", __dir__)
topology_path = ENV.fetch("VM_TOPOLOGY", File.join(repo_root, "provisioning/config/topology.yml"))
release_path = ENV.fetch("VM_RELEASE", File.join(repo_root, "provisioning/config/release.json"))
topology = YAML.safe_load_file(topology_path)
release = JSON.parse(File.read(release_path))
environment_id = ENV.fetch("VM_ENV_ID", topology.fetch("environmentId"))
profile_name = ENV.fetch("VM_PROFILE", topology.fetch("defaultResourceProfile"))
profile = topology.fetch("resourceProfiles").fetch(profile_name)
release_id = release.fetch("releaseId")
problem_box = ENV.fetch("ISUREAL_PROBLEM_BOX", "isureal/problem-server-#{release_id}")
router_box = ENV.fetch("ISUREAL_ROUTER_BOX", "isureal/router-#{release_id}")

def interface(topology, node_id, role)
  topology.fetch("nodes").fetch(node_id).fetch("interfaces").find do |candidate|
    candidate.fetch("role") == role
  end.fetch("macAddress")
end

def network(topology, name)
  topology.fetch("networks").fetch(name)
end

def netmask(cidr)
  IPAddr.new(cidr).netmask.to_s
end

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.insert_key = false
  config.ssh.keep_alive = true

  config.vm.define "app1" do |app1|
    data = network(topology, "app1Data")
    app1.vm.box = problem_box
    app1.vm.hostname = topology.fetch("nodes").fetch("app1").fetch("hostname")
    app1.vm.network "forwarded_port", id: "ssh", guest: 22, host: topology.fetch("sshPorts").fetch("app1"),
                       host_ip: "127.0.0.1", auto_correct: false
    app1.vm.network "private_network", ip: data.fetch("peerAddress"), netmask: netmask(data.fetch("cidr")),
                       virtualbox__intnet: "#{environment_id}-app1-data"
    app1.vm.provider "virtualbox" do |vb|
      vb.name = "#{environment_id}-app1"
      vb.cpus = profile.fetch("problemServer").fetch("cpus")
      vb.memory = profile.fetch("problemServer").fetch("memoryMiB")
      vb.customize ["modifyvm", :id, "--macaddress1", interface(topology, "app1", "bootstrap0")]
      vb.customize ["modifyvm", :id, "--macaddress2", interface(topology, "app1", "data0")]
    end
  end

  config.vm.define "app2" do |app2|
    data = network(topology, "app2Data")
    app2.vm.box = problem_box
    app2.vm.hostname = topology.fetch("nodes").fetch("app2").fetch("hostname")
    app2.vm.network "forwarded_port", id: "ssh", guest: 22, host: topology.fetch("sshPorts").fetch("app2"),
                       host_ip: "127.0.0.1", auto_correct: false
    app2.vm.network "private_network", ip: data.fetch("peerAddress"), netmask: netmask(data.fetch("cidr")),
                       virtualbox__intnet: "#{environment_id}-app2-data"
    app2.vm.provider "virtualbox" do |vb|
      vb.name = "#{environment_id}-app2"
      vb.cpus = profile.fetch("problemServer").fetch("cpus")
      vb.memory = profile.fetch("problemServer").fetch("memoryMiB")
      vb.customize ["modifyvm", :id, "--macaddress1", interface(topology, "app2", "bootstrap0")]
      vb.customize ["modifyvm", :id, "--macaddress2", interface(topology, "app2", "data0")]
    end
  end

  config.vm.define "app3" do |app3|
    data = network(topology, "app3Data")
    app3.vm.box = problem_box
    app3.vm.hostname = topology.fetch("nodes").fetch("app3").fetch("hostname")
    app3.vm.network "forwarded_port", id: "ssh", guest: 22, host: topology.fetch("sshPorts").fetch("app3"),
                       host_ip: "127.0.0.1", auto_correct: false
    app3.vm.network "private_network", ip: data.fetch("peerAddress"), netmask: netmask(data.fetch("cidr")),
                       virtualbox__intnet: "#{environment_id}-app3-data"
    app3.vm.provider "virtualbox" do |vb|
      vb.name = "#{environment_id}-app3"
      vb.cpus = profile.fetch("problemServer").fetch("cpus")
      vb.memory = profile.fetch("problemServer").fetch("memoryMiB")
      vb.customize ["modifyvm", :id, "--macaddress1", interface(topology, "app3", "bootstrap0")]
      vb.customize ["modifyvm", :id, "--macaddress2", interface(topology, "app3", "data0")]
    end
  end

  config.vm.define "db1" do |db1|
    data = network(topology, "db1Data")
    db1.vm.box = problem_box
    db1.vm.hostname = topology.fetch("nodes").fetch("db1").fetch("hostname")
    db1.vm.network "forwarded_port", id: "ssh", guest: 22, host: topology.fetch("sshPorts").fetch("db1"),
                       host_ip: "127.0.0.1", auto_correct: false
    db1.vm.network "private_network", ip: data.fetch("peerAddress"), netmask: netmask(data.fetch("cidr")),
                       virtualbox__intnet: "#{environment_id}-db1-data"
    db1.vm.provider "virtualbox" do |vb|
      vb.name = "#{environment_id}-db1"
      vb.cpus = profile.fetch("problemServer").fetch("cpus")
      vb.memory = profile.fetch("problemServer").fetch("memoryMiB")
      vb.customize ["modifyvm", :id, "--macaddress1", interface(topology, "db1", "bootstrap0")]
      vb.customize ["modifyvm", :id, "--macaddress2", interface(topology, "db1", "data0")]
    end
  end

  config.vm.define "router" do |router|
    data1 = network(topology, "app1Data")
    data2 = network(topology, "app2Data")
    data3 = network(topology, "app3Data")
    data4 = network(topology, "db1Data")
    control = network(topology, "control")
    client = topology.fetch("clientForward")
    client_tls = topology.fetch("clientTlsForward")
    router.vm.box = router_box
    router.vm.hostname = topology.fetch("nodes").fetch("router").fetch("hostname")
    router.vm.network "forwarded_port", id: "ssh", guest: 22, host: topology.fetch("sshPorts").fetch("router"),
                      host_ip: "127.0.0.1", auto_correct: false
    router.vm.network "forwarded_port", id: "client", guest: client.fetch("guestPort"), host: client.fetch("hostPort"),
                      host_ip: client.fetch("hostAddress"), protocol: client.fetch("protocol"),
                      auto_correct: client.fetch("autoCorrect")
    router.vm.network "forwarded_port", id: "client-tls", guest: client_tls.fetch("guestPort"), host: client_tls.fetch("hostPort"),
                      host_ip: client_tls.fetch("hostAddress"), protocol: client_tls.fetch("protocol"),
                      auto_correct: client_tls.fetch("autoCorrect")
    router.vm.network "private_network", ip: data1.fetch("routerAddress"), netmask: netmask(data1.fetch("cidr")),
                      virtualbox__intnet: "#{environment_id}-app1-data"
    router.vm.network "private_network", ip: data2.fetch("routerAddress"), netmask: netmask(data2.fetch("cidr")),
                      virtualbox__intnet: "#{environment_id}-app2-data"
    router.vm.network "private_network", ip: data3.fetch("routerAddress"), netmask: netmask(data3.fetch("cidr")),
                      virtualbox__intnet: "#{environment_id}-app3-data"
    router.vm.network "private_network", ip: data4.fetch("routerAddress"), netmask: netmask(data4.fetch("cidr")),
                      virtualbox__intnet: "#{environment_id}-db1-data"
    router.vm.network "private_network",
                      ip: control.fetch("routerAddress"),
                      netmask: netmask(control.fetch("cidr")),
                      adapter_ip: control.fetch("hostAddress")
    router.vm.provider "virtualbox" do |vb|
      vb.name = "#{environment_id}-router"
      vb.cpus = profile.fetch("router").fetch("cpus")
      vb.memory = profile.fetch("router").fetch("memoryMiB")
      vb.customize ["modifyvm", :id, "--macaddress1", interface(topology, "router", "bootstrap0")]
      vb.customize ["modifyvm", :id, "--macaddress2", interface(topology, "router", "data1")]
      vb.customize ["modifyvm", :id, "--macaddress3", interface(topology, "router", "data2")]
      vb.customize ["modifyvm", :id, "--macaddress4", interface(topology, "router", "data3")]
      vb.customize ["modifyvm", :id, "--macaddress5", interface(topology, "router", "data4")]
      vb.customize ["modifyvm", :id, "--macaddress6", interface(topology, "router", "control0")]
    end
  end
end
