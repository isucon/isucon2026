#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC
  apt:
    geoip: false
    mirror-selection:
      primary:
        - arches:
            - amd64
          uri: http://archive.ubuntu.com/ubuntu
    fallback: abort
  identity:
    hostname: isureal-packer
    username: vagrant
    password: "$6$isucon2026$BYPiGtDLxuVauDdBGBdzk6sSkQN8d8WSfhfScIy/6ye2Uzs62TurJej6.RXUpboyplDAL0cVktBUy5BrHrRXx/"
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - ssh-rsa  vagrant insecure public key
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key
  storage:
    layout:
      name: direct
  packages:
    - ca-certificates
    - curl
    - openssh-server
    - python3
    - rsync
    - virtualbox-guest-utils
  late-commands:
    - curtin in-target --target=/target -- install -d -m 0700 -o vagrant -g vagrant /home/vagrant/.ssh
    - curtin in-target --target=/target -- sh -c "printf '%s\n' 'ssh-rsa  vagrant insecure public key' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key' > /home/vagrant/.ssh/authorized_keys"
    - curtin in-target --target=/target -- chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
    - curtin in-target --target=/target -- chmod 0600 /home/vagrant/.ssh/authorized_keys
    - curtin in-target --target=/target -- sh -c "printf '%s\n' 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/99-vagrant"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/99-vagrant
