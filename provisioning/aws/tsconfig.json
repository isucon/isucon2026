{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "*.ts",
    "lib/**/*.ts",
    "tests/**/*.ts",
    "supervisor/**/*.ts",
    "pulumi-state/**/*.ts"
  ]
}
