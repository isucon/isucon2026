ISUREAL_LISTEN_ADDRESS=:8080
ISUREAL_PUBLIC_ORIGIN=http://localhost:5173
ISUREAL_DATABASE_URL=postgres://isureal:local-development-only@localhost:5432/isureal?sslmode=disable
ISUREAL_IMAGE_ROOT=/var/lib/isureal/images
ISUREAL_CURSOR_HMAC_KEY=local-development-cursor-key-change-me
ISUREAL_VAPID_PUBLIC_KEY=
ISUREAL_VAPID_PRIVATE_KEY=
ISUREAL_VAPID_SUBJECT=
ISUREAL_WORKER_POLL_INTERVAL=1s
ISUREAL_WORKER_BATCH_SIZE=50
ISUREAL_IMAGE_SANITIZER_PATH=/usr/local/bin/image-sanitizer
ISUREAL_IMAGE_SANITIZER_CONCURRENCY=2
ISUREAL_IMAGE_SANITIZER_MEMORY_BYTES=536870912
ISUREAL_IMAGE_SANITIZER_CPU_SECONDS=10
ISUREAL_IMAGE_SANITIZER_TIMEOUT=15s
