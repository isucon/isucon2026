# Portal Mock は ISUReal 本体とは独立して起動します。
# ローカルで上書きする場合は、このファイルを portal-mock/.env へコピーしてください。

# 起動対象チーム。正の整数のみ。
PORTAL_TEAM_NUMBER=1

# 公開ホスト名を推測しにくくするためのローカル開発用ダミー値。
# 認証・認可・TeamKey には使用しません。
PORTAL_TEAM_HASH=abc123

# app/app1-3 の表示用ホスト名に付与する DNS suffix。
PORTAL_DOMAIN_SUFFIX=isucon2026.westens.tokyo

# stand-in（既定）または external-router。起動後の変更はできません。
PORTAL_ROUTER_MODE=stand-in

# stand-in 時のみ有効:
# success | fail-once-then-success | no-report
PORTAL_STANDIN_PROFILE=success

# desired と applied の不一致を DELAYED と表示するまでの時間。
PORTAL_APPLY_TIMEOUT_MS=3000

# stand-in の報告遅延と fail-once の再試行間隔。
PORTAL_STANDIN_DELAY_MS=100
PORTAL_STANDIN_RETRY_MS=150

# 決定的ベンチマークシミュレーションの pending 時間と進捗 step 間隔。
PORTAL_BENCHMARK_PENDING_MS=200
PORTAL_BENCHMARK_STEP_MS=120

# コンテナ内の HTTP listen address。ホスト公開ポートは下記と分離します。
PORTAL_LISTEN_ADDRESS=0.0.0.0:8080

# 任意: Server 自身に SPA を配信させる場合のディレクトリ。
# Compose は専用 nginx を使うため空のままにします。
PORTAL_WEB_DIR=

# Docker Compose がホストへ公開するアドレスとポート。
# 既定値は loopback であり、0.0.0.0 へは公開しません。
PORTAL_SERVER_BIND_IP=127.0.0.1
PORTAL_SERVER_PORT=8080
PORTAL_WEB_BIND_IP=127.0.0.1
PORTAL_WEB_PORT=5174
