{
  "name": "isureal-nodejs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "tsc && node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write src test package.json tsconfig.json",
    "format:check": "prettier --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.1",
    "unicode-case-folding": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
