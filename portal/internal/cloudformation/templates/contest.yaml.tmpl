AWSTemplateFormatVersion: 2010-09-09
Description: >-
  AWS CloudFormation for ISUCON2026 Contest
Resources:
  GetAvailabilityZoneFunctionExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: 2012-10-17
        Statement:
          - Effect: Allow
            Principal:
              Service:
                - lambda.amazonaws.com
            Action:
              - sts:AssumeRole
      Path: "/"
      Policies:
        - PolicyName: GetAvailabilityZoneFunctionPolicy
          PolicyDocument:
            Version: 2012-10-17
            Statement:
              - Effect: Allow
                Action:
                  - ec2:DescribeAvailabilityZones
                Resource: "*"
  GetAvailabilityZoneFunction:
    Type: AWS::Lambda::Function
    Properties:
      Code:
        ZipFile: |
          import cfnresponse
          import boto3
          def handler(event, context):
            if event['RequestType'] in ("Create", "Update"):
              ec2 = boto3.client('ec2')
              response = ec2.describe_availability_zones(
                ZoneIds = ['{{.ZoneID}}']
              )
              ZoneName = response['AvailabilityZones'][0]['ZoneName']
              cfnresponse.send(event, context, cfnresponse.SUCCESS, {"ZoneName" : ZoneName})
            elif event['RequestType'] == "Delete":
              cfnresponse.send(event, context, cfnresponse.SUCCESS, {})
      Handler: index.handler
      Runtime: python3.12
      Timeout: 30
      Role: !GetAtt GetAvailabilityZoneFunctionExecutionRole.Arn
  GetAvailabilityZone:
    Type: Custom::PythonLambdaExecution
    Properties:
      ServiceToken: !GetAtt GetAvailabilityZoneFunction.Arn

  VPC:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: "192.168.0.0/16"
      EnableDnsSupport: "true"
      EnableDnsHostnames: "true"
      InstanceTenancy: default
  InternetGateway:
    Type: AWS::EC2::InternetGateway
  InternetGatewayAttachment:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      InternetGatewayId: !Ref InternetGateway
      VpcId: !Ref VPC
  ServiceLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateData:
        BlockDeviceMappings:
          - DeviceName: /dev/sda1
            Ebs:
              VolumeType: gp3
              VolumeInitializationRate: 300
              DeleteOnTermination: true
  DatabaseLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateData:
        BlockDeviceMappings:
          - DeviceName: /dev/sda1
            Ebs:
              VolumeType: gp3
              VolumeInitializationRate: 300
              Iops: 6000
              Throughput: 200
              DeleteOnTermination: true
  RouterPublicSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      AvailabilityZone: !GetAtt GetAvailabilityZone.ZoneName
      CidrBlock: 192.168.11.0/24
  RouterDataSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      AvailabilityZone: !GetAtt GetAvailabilityZone.ZoneName
      CidrBlock: 192.168.10.0/24
  PublicRoutes:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
  PublicDefaultRoute:
    Type: AWS::EC2::Route
    DependsOn: InternetGatewayAttachment
    Properties:
      RouteTableId: !Ref PublicRoutes
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway
  RouterPublicRoutes:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref RouterPublicSubnet
      RouteTableId: !Ref PublicRoutes
  RouterPublicSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      VpcId: !Ref VPC
      GroupDescription: Benchmark ingress to the Router
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 8080
          ToPort: 8080
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          CidrIp: 0.0.0.0/0
  RouterDataSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      VpcId: !Ref VPC
      GroupDescription: Forward traffic between contest servers
      SecurityGroupIngress:
{{range .ContestServers}}
        - IpProtocol: '-1'
          CidrIp: 192.168.{{.Number}}.0/24
{{end}}
  RouterPublicInterface:
    Type: AWS::EC2::NetworkInterface
    Properties:
      SubnetId: !Ref RouterPublicSubnet
      PrivateIpAddress: 192.168.11.10
      GroupSet: [!Ref RouterPublicSecurityGroup]
  RouterDataInterface:
    Type: AWS::EC2::NetworkInterface
    Properties:
      SubnetId: !Ref RouterDataSubnet
      PrivateIpAddress: 192.168.10.10
      SourceDestCheck: false
      GroupSet: [!Ref RouterDataSecurityGroup]

{{range .ContestServers}}
  {{.ID}}Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      AvailabilityZone: !GetAtt GetAvailabilityZone.ZoneName
      CidrBlock: 192.168.{{.Number}}.0/24
  {{.ID}}Routes:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
  {{.ID}}RouteAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref {{.ID}}Subnet
      RouteTableId: !Ref {{.ID}}Routes
  {{.ID}}DefaultRoute:
    Type: AWS::EC2::Route
    DependsOn: InternetGatewayAttachment
    Properties:
      RouteTableId: !Ref {{.ID}}Routes
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway
{{$server := .}}{{range $.ContestServers}}{{if ne .Number $server.Number}}
  {{$server.ID}}To{{.ID}}:
    Type: AWS::EC2::Route
    DependsOn: [{{.ID}}Subnet, Router]
    Properties:
      RouteTableId: !Ref {{$server.ID}}Routes
      DestinationCidrBlock: 192.168.{{.Number}}.0/24
      NetworkInterfaceId: !Ref RouterDataInterface
{{end}}{{end}}
  {{.ID}}SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      VpcId: !Ref VPC
      GroupDescription: Contest server SSH and routed traffic
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: '-1'
          CidrIp: 192.168.10.10/32
{{range $.ContestServers}}{{if ne .Number $server.Number}}
        - IpProtocol: '-1'
          CidrIp: 192.168.{{.Number}}.0/24
{{end}}{{end}}
  {{.ID}}:
    Type: AWS::EC2::Instance
    DependsOn: [{{.ID}}DefaultRoute, {{.ID}}RouteAssociation{{range $.ContestServers}}{{if ne .Number $server.Number}}, {{$server.ID}}To{{.ID}}{{end}}{{end}}]
    Properties:
      ImageId: {{$.AMIID}}
      InstanceType: {{.InstanceType}}
      SubnetId: !Ref {{.ID}}Subnet
      PrivateIpAddress: 192.168.{{.Number}}.10
      SecurityGroupIds: [!Ref {{.ID}}SecurityGroup]
      MetadataOptions:
        HttpTokens: required
      LaunchTemplate:
        LaunchTemplateId: !Ref {{if .Region}}Service{{else}}Database{{end}}LaunchTemplate
        Version: !GetAtt {{if .Region}}Service{{else}}Database{{end}}LaunchTemplate.LatestVersionNumber
      Tags:
        - Key: Name
          Value: isucon2026-contest-{{.Number}}
        - Key: IsuconTeamID
          Value: '{{$.TeamID}}'
        - Key: IsuconInstanceNum
          Value: '{{.Number}}'
      UserData:
        Fn::Base64: |
          #cloud-config
{{template "admin_ssh" $}}
          write_files:
          - path: /opt/isucon-env-checker/portal_credentials.json
            permissions: '0600'
            encoding: b64
            content: '{{$.PortalCredentials}}'
          - path: /etc/isucon/registration.json
            permissions: '0600'
            encoding: b64
            content: '{{$.Registration .Number}}'
          - path: /opt/isucon-registration/register.py
            permissions: '0700'
            encoding: gz+b64
            content: '{{$.RegistrationScript}}'
{{template "contest_registration_service" $}}
          runcmd:
{{template "ssh_public_keys" $}}
{{if .Region}}
            - sed -i -e 's/^ISUREAL_REGION=.*/ISUREAL_REGION={{.Region}}/' -e 's/^ISUREAL_DB_HOST=.*/ISUREAL_DB_HOST=192.168.4.10/' /home/isucon/env.sh
            - systemctl enable --now isureal-go nginx
            - systemctl enable --now isureal-guard
{{else}}
            - systemctl enable --now postgresql
{{end}}
            - systemctl daemon-reload
            - systemctl enable --now --no-block isucon-register.service
  {{.ID}}IP:
    Type: AWS::EC2::EIP
    DependsOn: InternetGatewayAttachment
    Properties:
      Domain: vpc
      InstanceId: !Ref {{.ID}}
{{end}}
  ServerACL:
    Type: AWS::EC2::NetworkAcl
    Properties:
      VpcId: !Ref VPC
  ServerACLIngress:
    Type: AWS::EC2::NetworkAclEntry
    Properties:
      NetworkAclId: !Ref ServerACL
      RuleNumber: 1000
      Protocol: -1
      RuleAction: allow
      Egress: false
      CidrBlock: 0.0.0.0/0
  ServerACLBlockRouterPublicIP:
    Type: AWS::EC2::NetworkAclEntry
    Properties:
      NetworkAclId: !Ref ServerACL
      RuleNumber: 100
      Protocol: -1
      RuleAction: deny
      Egress: true
      CidrBlock: !Sub '${RouterIP}/32'
  ServerACLBlockRouterPublicSubnet:
    Type: AWS::EC2::NetworkAclEntry
    Properties:
      NetworkAclId: !Ref ServerACL
      RuleNumber: 110
      Protocol: -1
      RuleAction: deny
      Egress: true
      CidrBlock: 192.168.11.0/24
  ServerACLEgress:
    Type: AWS::EC2::NetworkAclEntry
    Properties:
      NetworkAclId: !Ref ServerACL
      RuleNumber: 1000
      Protocol: -1
      RuleAction: allow
      Egress: true
      CidrBlock: 0.0.0.0/0
{{range .ContestServers}}
  {{.ID}}ACLAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties:
      SubnetId: !Ref {{.ID}}Subnet
      NetworkAclId: !Ref ServerACL
{{end}}
  Router:
    Type: AWS::EC2::Instance
    DependsOn: [PublicDefaultRoute, RouterPublicRoutes]
    Properties:
      ImageId: {{$.RouterAMIID}}
      InstanceType: c6in.large
      NetworkInterfaces:
        - DeviceIndex: '0'
          NetworkInterfaceId: !Ref RouterPublicInterface
        - DeviceIndex: '1'
          NetworkInterfaceId: !Ref RouterDataInterface
      MetadataOptions:
        HttpTokens: required
      BlockDeviceMappings:
        - DeviceName: /dev/sda1
          Ebs:
            VolumeType: gp3
            DeleteOnTermination: true
      Tags:
        - Key: Name
          Value: isucon2026-contest-router
        - Key: IsuconTeamID
          Value: '{{.TeamID}}'
        - Key: IsuconInstanceNum
          Value: '5'
      UserData:
        Fn::Base64: |
          #cloud-config
{{template "admin_ssh" $}}
          bootcmd:
            - [dpkg, --purge, ec2-instance-connect]
            - [systemctl, daemon-reload]
            - [systemctl, try-restart, ssh.service]
          write_files:
          - path: /etc/isucon/registration.json
            permissions: '0600'
            encoding: b64
            content: '{{.Registration 5}}'
          - path: /opt/isucon-registration/register.py
            permissions: '0700'
            encoding: gz+b64
            content: '{{.RegistrationScript}}'
          - path: /opt/isucon-registration/router-bootstrap.py
            permissions: '0700'
            encoding: gz+b64
            content: '{{.RouterBootstrap}}'
          - path: /etc/isucon/router.env
            owner: root:isureal-router
            permissions: '0640'
            content: |
              ROUTER_PORTAL_ENDPOINT=http://127.0.0.1:18082
              ROUTER_TEAM_NUMBER={{.TeamID}}
              ROUTER_STATUS_LISTEN_ADDRESS=192.168.11.10:18081
              ROUTER_HTTP_LISTEN_ADDRESS=0.0.0.0:8080
              ROUTER_HTTPS_LISTEN_ADDRESS=0.0.0.0:443
              ROUTER_TLS_CERTIFICATE=/etc/isucon/haproxy/tls/server.pem
              ROUTER_UPSTREAM_PORT=80
{{range .ContestServers}}
              ROUTER_{{if .Region}}APP{{.Number}}{{else}}DB1{{end}}_SUBNET=192.168.{{.Number}}.0/24
              ROUTER_{{if .Region}}APP{{.Number}}{{else}}DB1{{end}}_REGION_LOCAL_IP=192.168.10.10
              ROUTER_{{if .Region}}APP{{.Number}}{{else}}DB1{{end}}_IP=192.168.{{.Number}}.10
{{end}}
          - path: /etc/isucon/portal.env
            owner: root:isureal-router
            permissions: '0640'
            content: |
              PORTAL_TEAM_NUMBER={{.TeamID}}
              PORTAL_TEAM_HASH=aws
              PORTAL_DOMAIN_SUFFIX=127.0.0.1.nip.io
              PORTAL_ROUTER_MODE=external-router
              PORTAL_LISTEN_ADDRESS=127.0.0.1:18082
              PORTAL_WEB_DIR=
          - path: /etc/systemd/system/isucon-register.service.d/router.conf
            permissions: '0644'
            content: |
              [Unit]
              Wants=isucon-router-bootstrap.service
              After=isucon-router-bootstrap.service
              [Service]
              ExecStartPre=/usr/bin/systemctl is-active isucon-router-bootstrap.service
          - path: /etc/systemd/system/isucon-router-bootstrap.service
            permissions: '0644'
            content: |
              [Unit]
              Description=Configure ISUCON2026 Router network on every boot
              Wants=network-online.target
              After=network-online.target cloud-final.service
              StartLimitIntervalSec=0
              [Service]
              Type=oneshot
              ExecStart=/usr/bin/python3 /opt/isucon-registration/router-bootstrap.py
              ExecStart=/usr/bin/systemctl start isureal-portal isureal-router isureal-haproxy
              Restart=on-failure
              RestartSec=10s
              RemainAfterExit=yes
              [Install]
              WantedBy=cloud-init.target
{{template "contest_registration_service" .}}
          runcmd:
            - |
              set -eu
              umask 077
              cd /etc/isucon/haproxy/tls
              openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj '/CN={{.AppHost}}' -keyout server.key -out server.crt
              cat server.crt server.key > server.pem
              chown root:isureal-router server.pem
              chmod 0640 server.pem
              rm server.key server.crt
            - systemctl daemon-reload
            - systemctl enable --now --no-block isucon-router-bootstrap.service
            - systemctl enable --now --no-block isucon-register.service
  RouterIP:
    Type: AWS::EC2::EIP
    DependsOn: InternetGatewayAttachment
    Properties:
      Domain: vpc
  RouterIPAssociation:
    Type: AWS::EC2::EIPAssociation
    Properties:
      AllocationId: !GetAtt RouterIP.AllocationId
      NetworkInterfaceId: !Ref RouterPublicInterface
Outputs:
{{range .ContestServers}}
  {{.ID}}PublicIP:
    Value: !Ref {{.ID}}IP
{{end}}
  RouterPublicIP:
    Value: !Ref RouterIP
  BenchmarkHost:
    Value: '{{.AppHost}}'
{{define "contest_registration_service"}}
          - path: /etc/systemd/system/isucon-register.service
            permissions: '0644'
            content: |
              [Unit]
              Description=Register the contest instance with the portal on every boot
              Wants=network-online.target
              After=network-online.target cloud-final.service
              StartLimitIntervalSec=0
              [Service]
              Type=oneshot
              ExecStart=/usr/bin/python3 /opt/isucon-registration/register.py
              Restart=on-failure
              RestartSec=20s
              RemainAfterExit=yes
              [Install]
              WantedBy=cloud-init.target
{{end}}
