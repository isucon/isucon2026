{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isucon2026.invalid/schemas/local-vm-topology-v2.json",
  "title": "ISUCON 2026 local VM topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentId",
    "baseCidr",
    "domain",
    "portal",
    "clientForward",
    "sshPorts",
    "resourceProfiles",
    "defaultResourceProfile",
    "networks",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "environmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,31}$"
    },
    "baseCidr": {
      "$ref": "#/$defs/ipv4Cidr"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "composeFile",
        "routerMode",
        "teamNumber",
        "teamHash",
        "apiHostPort",
        "apiContainerPort",
        "uiHostAddress",
        "uiHostPort",
        "uiContainerPort"
      ],
      "properties": {
        "mode": {
          "const": "docker-compose"
        },
        "composeFile": {
          "type": "string",
          "const": "portal-mock/compose.yaml"
        },
        "routerMode": {
          "const": "external-router"
        },
        "teamNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "teamHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
        },
        "apiHostPort": {
          "$ref": "#/$defs/tcpPort",
          "default": 18082
        },
        "apiContainerPort": {
          "const": 8080
        },
        "uiHostAddress": {
          "const": "127.0.0.1"
        },
        "uiHostPort": {
          "$ref": "#/$defs/tcpPort",
          "default": 15174
        },
        "uiContainerPort": {
          "const": 5174
        }
      }
    },
    "clientForward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostAddress", "hostPort", "guestPort", "protocol", "autoCorrect"],
      "properties": {
        "hostAddress": {
          "const": "127.0.0.1"
        },
        "hostPort": {
          "$ref": "#/$defs/tcpPort",
          "default": 18080
        },
        "guestPort": {
          "const": 8080
        },
        "protocol": {
          "const": "tcp"
        },
        "autoCorrect": {
          "const": false
        }
      }
    },
    "sshPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server1", "server2", "server3", "router"],
      "properties": {
        "server1": {
          "$ref": "#/$defs/tcpPort"
        },
        "server2": {
          "$ref": "#/$defs/tcpPort"
        },
        "server3": {
          "$ref": "#/$defs/tcpPort"
        },
        "router": {
          "$ref": "#/$defs/tcpPort"
        }
      }
    },
    "resourceProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problemServer", "router"],
        "properties": {
          "problemServer": {
            "$ref": "#/$defs/resources"
          },
          "router": {
            "$ref": "#/$defs/resources"
          }
        }
      }
    },
    "defaultResourceProfile": {
      "type": "string",
      "minLength": 1
    },
    "networks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server1Data", "server2Data", "server3Data", "control"],
      "properties": {
        "server1Data": {
          "$ref": "#/$defs/internalSegment"
        },
        "server2Data": {
          "$ref": "#/$defs/internalSegment"
        },
        "server3Data": {
          "$ref": "#/$defs/internalSegment"
        },
        "control": {
          "$ref": "#/$defs/hostOnlySegment"
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server1", "server2", "server3", "router"],
      "properties": {
        "server1": {
          "$ref": "#/$defs/problemNode"
        },
        "server2": {
          "$ref": "#/$defs/problemNode"
        },
        "server3": {
          "$ref": "#/$defs/problemNode"
        },
        "router": {
          "$ref": "#/$defs/routerNode"
        }
      }
    }
  },
  "$defs": {
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "ipv4": {
      "type": "string",
      "format": "ipv4"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9A-F]{12}$",
      "description": "VirtualBox canonical uppercase MAC without separators"
    },
    "tcpPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpus", "memoryMiB", "diskGiB"],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 768,
          "maximum": 131072
        },
        "diskGiB": {
          "type": "integer",
          "minimum": 8,
          "maximum": 2048
        }
      }
    },
    "internalSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cidr", "routerAddress", "peerAddress"],
      "properties": {
        "kind": {
          "const": "internal"
        },
        "cidr": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "routerAddress": {
          "$ref": "#/$defs/ipv4"
        },
        "peerAddress": {
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "hostOnlySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cidr", "routerAddress", "hostAddress"],
      "properties": {
        "kind": {
          "const": "host-only"
        },
        "cidr": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "routerAddress": {
          "$ref": "#/$defs/ipv4"
        },
        "hostAddress": {
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "bootstrapInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "mode", "macAddress"],
      "properties": {
        "role": {
          "const": "bootstrap0"
        },
        "mode": {
          "const": "nat"
        },
        "macAddress": {
          "$ref": "#/$defs/mac"
        }
      }
    },
    "segmentInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "mode", "segment", "macAddress"],
      "properties": {
        "role": {
          "enum": ["data0", "data1", "data2", "data3", "control0"]
        },
        "mode": {
          "enum": ["intnet", "hostonly"]
        },
        "segment": {
          "enum": ["server1Data", "server2Data", "server3Data", "control"]
        },
        "macAddress": {
          "$ref": "#/$defs/mac"
        }
      }
    },
    "problemNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "hostname", "interfaces"],
      "properties": {
        "role": {
          "const": "problem-server"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "interfaces": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/bootstrapInterface"
            },
            {
              "$ref": "#/$defs/segmentInterface"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "routerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "hostname", "interfaces"],
      "properties": {
        "role": {
          "const": "router"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "interfaces": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/bootstrapInterface"
            },
            {
              "$ref": "#/$defs/segmentInterface"
            },
            {
              "$ref": "#/$defs/segmentInterface"
            },
            {
              "$ref": "#/$defs/segmentInterface"
            },
            {
              "$ref": "#/$defs/segmentInterface"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    }
  },
  "$comment": "JSON Schema checks shape only. Preflight MUST additionally check CIDR containment/non-overlap, reserved addresses, exact node-to-segment bindings, unique Client/Portal/SSH ports and MACs, control-address-specific Docker publishing, absence of extra Vagrant forwards, route conflicts, VirtualBox resources, and defaultResourceProfile membership."
}
