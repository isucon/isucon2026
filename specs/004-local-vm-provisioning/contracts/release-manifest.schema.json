{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isucon2026.invalid/schemas/provisioning-release-manifest-v3.json",
  "title": "ISUCON 2026 provisioning release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "createdAt",
    "sourceRevision",
    "toolchain",
    "ubuntu",
    "packages",
    "artifacts",
    "databaseContract",
    "routerContract",
    "portalContract"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "releaseId": {
      "type": "string",
      "pattern": "^r[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "ubuntu": {
      "$ref": "#/$defs/ubuntu"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "databaseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "majorVersion", "compatibilityId", "migrationArtifact"],
      "properties": {
        "engine": {
          "const": "postgresql"
        },
        "majorVersion": {
          "const": 16
        },
        "compatibilityId": {
          "$ref": "#/$defs/compatibilityId"
        },
        "migrationArtifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specRevision", "compatibilityId", "envoyVersion", "upstreamPort"],
      "properties": {
        "specRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "compatibilityId": {
          "$ref": "#/$defs/compatibilityId"
        },
        "envoyVersion": {
          "$ref": "#/$defs/semver"
        },
        "upstreamPort": {
          "const": 8080
        }
      }
    },
    "portalContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specRevision", "composeFile", "routerMode", "apiContainerPort", "uiContainerPort"],
      "properties": {
        "specRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "composeFile": {
          "const": "portal-mock/compose.yaml"
        },
        "routerMode": {
          "const": "external-router"
        },
        "apiContainerPort": {
          "const": 8080
        },
        "uiContainerPort": {
          "const": 5174
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packer",
        "vagrant",
        "virtualBox",
        "dockerEngine",
        "dockerCompose",
        "python",
        "ansibleCore",
        "packerPlugins",
        "ansibleCollections"
      ],
      "properties": {
        "packer": {
          "$ref": "#/$defs/semver"
        },
        "vagrant": {
          "$ref": "#/$defs/semver"
        },
        "virtualBox": {
          "$ref": "#/$defs/semver"
        },
        "dockerEngine": {
          "$ref": "#/$defs/semver"
        },
        "dockerCompose": {
          "$ref": "#/$defs/semver"
        },
        "python": {
          "$ref": "#/$defs/semver"
        },
        "ansibleCore": {
          "$ref": "#/$defs/semver"
        },
        "packerPlugins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["virtualbox", "vagrant", "ansible"],
          "properties": {
            "virtualbox": {
              "$ref": "#/$defs/semver"
            },
            "vagrant": {
              "$ref": "#/$defs/semver"
            },
            "ansible": {
              "$ref": "#/$defs/semver"
            },
            "amazon": {
              "$ref": "#/$defs/semver"
            }
          }
        },
        "ansibleCollections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["community.postgresql"],
          "properties": {
            "community.postgresql": {
              "$ref": "#/$defs/semver"
            }
          }
        }
      }
    },
    "ubuntu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "aptSnapshot", "installImages"],
      "properties": {
        "release": {
          "const": "24.04"
        },
        "aptSnapshot": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z$"
        },
        "installImages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amd64"],
          "properties": {
            "amd64": {
              "$ref": "#/$defs/installImage"
            }
          }
        }
      }
    },
    "installImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "serial"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "serial": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "roles"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["latest", "*"]
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["base", "problem-server", "router"]
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "version", "architecture", "uri", "compatibilityId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,127}$"
        },
        "component": {
          "enum": [
            "backend",
            "frontend",
            "router",
            "envoy",
            "database-migrations",
            "portal-mock"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "enum": ["amd64", "any"]
        },
        "uri": {
          "type": "string",
          "pattern": "^(file|https|s3)://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibilityId": {
          "$ref": "#/$defs/compatibilityId"
        }
      }
    }
  },
  "$comment": "Semantic validation MUST reject duplicate package/artifact keys, a missing required amd64 artifact, use of 'any' for an architecture-dependent artifact, mutable/signed temporary artifact URIs, secret fields, reused release IDs, database/migration compatibility mismatches, Portal source/Compose contract mismatches, and source revisions that do not contain the pinned specs."
}
