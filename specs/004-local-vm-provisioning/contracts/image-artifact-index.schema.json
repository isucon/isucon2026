{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isucon2026.invalid/schemas/image-artifact-index-v2.json",
  "title": "ISUCON 2026 machine image artifact index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "artifacts"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "releaseId",
        "role",
        "provider",
        "architecture",
        "sourceImageId",
        "buildName",
        "buildTime",
        "sourceRevision",
        "output",
        "validationState",
        "validationReports"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]{2,255}$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^r[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
        },
        "role": {
          "enum": ["base", "problem-server", "router"]
        },
        "provider": {
          "enum": ["virtualbox", "amazon-ebs"]
        },
        "architecture": {
          "const": "amd64"
        },
        "sourceImageId": {
          "type": "string",
          "minLength": 1
        },
        "buildName": {
          "type": "string",
          "minLength": 1
        },
        "buildTime": {
          "type": "string",
          "format": "date-time"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "output": {
          "oneOf": [
            {
              "$ref": "#/$defs/boxOutput"
            },
            {
              "$ref": "#/$defs/amiOutput"
            }
          ]
        },
        "validationState": {
          "enum": ["unverified", "validated", "rejected", "promoted"]
        },
        "validationReports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "boxOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256"],
      "properties": {
        "kind": {
          "const": "vagrant-box"
        },
        "uri": {
          "type": "string",
          "pattern": "^(file|https|s3)://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "amiOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "region", "amiId", "ownerId"],
      "properties": {
        "kind": {
          "const": "ami"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$"
        },
        "amiId": {
          "type": "string",
          "pattern": "^ami-[0-9a-f]+$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        }
      }
    }
  },
  "$comment": "The implementation MUST enforce uniqueness by releaseId+role+provider+architecture. promoted requires the Linux x86_64/VirtualBox/amd64 validation report and an immutable output; rejected and promoted records are terminal. vm-up may resolve only promoted virtualbox artifacts matching the exact release and amd64 architecture."
}
